# Copy to .env.local for local dev (vite auto-loads it, gitignored).
# Value is template.yaml's PublicApiUrl stack output -- PublicHttpApi is
# unauthenticated (no bearer token needed here, unlike ADMIN_API_URL
# elsewhere in this repo).
VITE_PUBLIC_API_URL=https://<your-api-id>.execute-api.us-west-1.amazonaws.com
