# Copy to .env.local for local dev (vite auto-loads it, gitignored).
# Value is template.yaml's PublicApiUrl stack output -- same
# unauthenticated PublicHttpApi consumer-site/.env.example points at, no
# bearer token needed here either.
VITE_PUBLIC_API_URL=https://<your-api-id>.execute-api.us-west-1.amazonaws.com
