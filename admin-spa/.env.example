# Copy to .env.local for local dev (vite auto-loads it, gitignored).
#
# VITE_ADMIN_API_URL -- template.yaml's AdminApiUrl stack output (the
# AdminHttpApi invoke URL; same one admin-site/index.html's config bar
# points at). Unlike consumer-site's VITE_PUBLIC_API_URL, every request
# here carries an Authorization: Bearer <Cognito ID token> header -- see
# src/auth/cognito.ts.
VITE_ADMIN_API_URL=https://<your-admin-api-id>.execute-api.us-west-1.amazonaws.com

# The three Cognito values below come straight off the main stack's
# Outputs (AdminUserPoolId / AdminUserPoolClientId), plus the region the
# stack is deployed in:
#
#   aws cloudformation describe-stacks --stack-name <your-stack-name> \
#     --query "Stacks[0].Outputs[?OutputKey=='AdminUserPoolId'].OutputValue" --output text
#   aws cloudformation describe-stacks --stack-name <your-stack-name> \
#     --query "Stacks[0].Outputs[?OutputKey=='AdminUserPoolClientId'].OutputValue" --output text
#
# None of these three are secret -- AdminUserPoolClient has no client
# secret (GenerateSecret: false in template.yaml, since a browser SPA
# can't keep one confidential); Cognito's security comes from the
# user's own credentials + SRP, not from these ids being hidden.
VITE_COGNITO_USER_POOL_ID=us-west-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_REGION=us-west-1
